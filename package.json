{
	"name": "view-ignored",
	"version": "0.12.2",
	"description": "Retrieve list of files ignored/included by Git, NPM, Yarn, JSR, Deno, Bun, VSCode extension CLI and other tools.",
	"keywords": [
		"arborist",
		"diff",
		"exclude",
		"files",
		"git",
		"gitignore",
		"glob",
		"ignore",
		"ignorematch",
		"include",
		"ls",
		"match",
		"migration",
		"npm",
		"npmignore",
		"packlist",
		"paths",
		"tar",
		"tree",
		"vsce",
		"vscodeignore",
		"vsix",
		"walk",
		"wildmatch",
		"yarnignore"
	],
	"bugs": {
		"url": "https://github.com/Mopsgamer/view-ignored/issues"
	},
	"license": "MIT",
	"author": "Mopsgamer",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/Mopsgamer/view-ignored.git"
	},
	"bin": {
		"vign-diff": "./out/cli/vign-diff.js"
	},
	"directories": {
		"lib": "out"
	},
	"files": [
		"/out"
	],
	"type": "module",
	"exports": {
		".": {
			"types": "./out/index.d.ts",
			"default": "./out/index.js"
		},
		"./scan": {
			"types": "./out/scan.d.ts",
			"default": "./out/scan.js"
		},
		"./stream": {
			"types": "./out/stream.d.ts",
			"default": "./out/stream.js"
		},
		"./browser": {
			"types": "./out/browser.d.ts",
			"default": "./out/browser.js"
		},
		"./browser/scan": {
			"types": "./out/browser_scan.d.ts",
			"default": "./out/browser_scan.js"
		},
		"./browser/stream": {
			"types": "./out/browser_stream.d.ts",
			"default": "./out/browser_stream.js"
		},
		"./patterns": {
			"types": "./out/patterns/index.d.ts",
			"default": "./out/patterns/index.js"
		},
		"./targets": {
			"types": "./out/targets/index.d.ts",
			"default": "./out/targets/index.js"
		}
	},
	"publishConfig": {
		"access": "public"
	},
	"scripts": {
		"prerelease": "bun check && bun run test && bun run prod && bun run lint && bun run fmt --check && bun run ts-compat && bun run node-compat && bun publint --pack npm --strict && bun run badges --check",
		"heap": "bun scripts/scanHeap.js --snapshot",
		"heap:node": "node scripts/scanHeap.js --snapshot",
		"cpu": "bun run --expose-gc --cpu-prof --cpu-prof-md --cpu-prof-name CPU.me scripts/scan.js --skipInternal",
		"cpu:node": "node --expose-gc --cpu-prof --cpu-prof-name CPU.me.node.cpuprofile scripts/scan.js --skipInternal",
		"bench": "bun scripts/bench.js",
		"benchreadme": "bun scripts/benchreadme.js",
		"size": "bun scripts/size.js",
		"coverage": "bun run test --coverage --coverage-reporter=lcov",
		"test": "bun test --timeout 5000 src",
		"test:base": "TEST_PACKLIST=0 TEST_WILDMATCH=0 bun test --timeout 5000 src",
		"test:patterns": "bun test --timeout 5000 src/patterns",
		"test:targets": "bun test --timeout 5000 src/targets",
		"test:noself": "TEST_NO_SELF=1 bun test --timeout 5000 src",
		"test:self": "bun test --timeout 5000 src/testSelf*.test.ts",
		"test:self:git": "bun test --timeout 5000 src/testSelfGit.test.ts",
		"test:self:npm": "bun test --timeout 5000 src/testSelfNPM.test.ts",
		"test:packlist": "bun test src/test-npm-packlist/",
		"test:wildmatch": "bun test src/test-wildmatch/git-wildmatch.test.ts",
		"test:ignore": "TEST_NODEIGNORE=1 bun test src/test-wildmatch/node-ignore.test.ts",
		"badges": "bun scripts/badges.js",
		"lint": "bun run oxlint --type-aware",
		"fmt": "bun run oxfmt",
		"check": "bun tsc -p src --noEmit",
		"dev": "bun tsc -p src",
		"prod": "rm -rf out && bun tsc -p src/tsconfig.prod.json --emitDeclarationOnly && bun tsc -p src/tsconfig.prod.json --removeComments -d false && mv .gitignore .gitignore.tmp && oxfmt out; mv .gitignore.tmp .gitignore",
		"node-compat": "bun node-compat-22 && bun node-compat-24",
		"ts-compat": "bun run ts-compat-6 && bun run ts-compat-5",
		"node-compat-24": "bun node_modules/typescript6/bin/tsc -p src/tsconfig.prod24.json --noEmit",
		"node-compat-22": "bun node_modules/typescript6/bin/tsc -p src/tsconfig.prod22.json --noEmit",
		"ts-compat-5": "bun node_modules/typescript5/bin/tsc -p src/tsconfig.prod.json --noEmit --resolveJsonModule",
		"ts-compat-6": "bun node_modules/typescript6/bin/tsc -p src/tsconfig.prod.json --noEmit",
		"release:major": "bun run --bun release-it --increment=major",
		"release:minor": "bun run --bun release-it --increment=minor",
		"release:patch": "bun run --bun release-it --increment=patch"
	},
	"dependencies": {
		"picomatch": "^4.0.5",
		"strip-json-comments": "^5.0.3"
	},
	"devDependencies": {
		"@npmcli/arborist": "^10.0.2",
		"@release-it/keep-a-changelog": "latest",
		"@types/bun": "latest",
		"@types/ignore-walk": "npm:@types/ignore-walk@^4.0.3",
		"@types/node": "npm:@types/node@latest",
		"@types/node-22": "npm:@types/node@^22.20.1",
		"@types/node-24": "npm:@types/node@^24.13.3",
		"@types/picomatch": "^4.0.3",
		"bun-types": "latest",
		"ignore-walk": "latest",
		"memfs": "latest",
		"mitata": "latest",
		"npm-packlist": "^11.3.0",
		"oxfmt": "latest",
		"oxlint": "latest",
		"oxlint-tsgolint": "latest",
		"publint": "latest",
		"release-it": "latest",
		"typescript": "npm:typescript@^7.0.2",
		"typescript5": "npm:typescript@~5.7.3",
		"typescript6": "npm:typescript@^6.0.3"
	},
	"engines": {
		"node": ">=22"
	}
}
